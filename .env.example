PORT=5000
# Local MongoDB:   mongodb://127.0.0.1:27017/membership
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/membership?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/membership
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Number of days before expiry that a member is considered "Expiring Soon"
EXPIRING_SOON_DAYS=7

# OTP settings
OTP_EXPIRES_MINUTES=5
# 2Factor.in SMS OTP API key. Leave blank to use dev mode (OTP logged to console).
TWOFACTOR_API_KEY=
# Optional DLT-approved template name registered in your 2Factor dashboard.
TWOFACTOR_TEMPLATE_NAME=
